{
  "name": "nexo-atlantico-knowledge-case",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "Senior FDE client case for diagnosing, building, evaluating, and presenting governed People Operations decisions.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "ask": "node scripts/ask.ts",
    "self-check": "node scripts/self-check.ts",
    "evals": "node evals/run.ts",
    "evals:matrix": "node scripts/eval-matrix.ts",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "setup:model": "node scripts/materialize-model.ts",
    "verify:model": "node scripts/materialize-model.ts --verify",
    "build:index": "node scripts/build-semantic-index.ts",
    "verify:submission": "node scripts/verify-submission.ts",
    "export:candidate": "node scripts/export-candidate.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@huggingface/transformers": "3.7.2"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
